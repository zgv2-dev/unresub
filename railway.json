{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "packages/core/**",
      "packages/server/**",
      "packages/web/**",
      "package.json",
      "pnpm-lock.yaml",
      "Dockerfile",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node --disable-warning=ExperimentalWarning packages/server/dist/index.mjs",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
