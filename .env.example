# Everything is optional. A fresh server works with no variables at all.

# Public https URL of this server. Needed for monobank webhooks (instant updates).
PUBLIC_URL=
PORT=8787
# Where core.db, users/<id>.db and secret.key live. Docker image: /data.
# DATA_DIR=./data
# Instance key (32 random bytes, base64). If unset, it's generated into DATA_DIR/secret.key.
# Generate: openssl rand -base64 32
# UNRESUB_SECRET_KEY=
# Fixed first-run setup code. If unset, one is generated and printed in the log.
# UNRESUB_SETUP_CODE=
# Incremental sync interval in hours
SYNC_INTERVAL_HOURS=6
# How far back the first backfill goes
BACKFILL_MONTHS=12
# How long a sign-in lasts without use
SESSION_DAYS=30
