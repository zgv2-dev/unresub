# 32 random bytes, base64. Generate: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
UNRESUB_SECRET_KEY=
# Bearer token the web UI uses to talk to the API
UNRESUB_API_TOKEN=
# Public https URL of this server, needed for monobank webhooks (optional)
PUBLIC_URL=
PORT=8787
# SQLite file. Defaults to ./unresub.db locally and /data/unresub.db in the Docker image;
# leave unset on Railway/Docker so it lands on the /data volume.
# DB_PATH=./unresub.db
# Incremental sync interval in hours
SYNC_INTERVAL_HOURS=6
# How far back the first backfill goes
BACKFILL_MONTHS=12
